# ==============================================================================
# PUB CertChain Environment Configuration
# Problem A1: Blockchain-Based Academic Certificate Verification
# Pundra University of Science & Technology (PUST)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# For local MongoDB instance:
# MONGODB_URI=mongodb://127.0.0.1:27017/certchain
#
# For MongoDB Atlas Cloud Replica Set:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/certchain?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Blockchain & Smart Contract (Ethereum Hardhat / Sepolia)
# ------------------------------------------------------------------------------
# Local Hardhat Node RPC (Run `npx hardhat node` in terminal)
CHAIN_RPC_URL=http://127.0.0.1:8545
# For Ethereum Sepolia Testnet (e.g. Infura / Alchemy):
# CHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Deployed CertChain Smart Contract Address
# (Updated automatically by `npx hardhat run scripts/deploy.js --network localhost`)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Hardhat Pre-funded Test Wallets (10,000 ETH each on localhost)
# Mnemonic: "test test test test test test test test test test test junk"
# Account #0: Super Admin (DEFAULT_ADMIN_ROLE) - 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Account #1: Controller of Examinations (CONTROLLER_ROLE) - 0x70997970C51812dc3A010C7d01b50e0d17dc79C8
CONTROLLER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Account #2: Authorized Certificate Issuer (ISSUER_ROLE) - 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
ISSUER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a

# ------------------------------------------------------------------------------
# 4. Email Service Configuration (Brevo / Sendinblue Transactional API)
# ------------------------------------------------------------------------------
# Brevo REST API v3 Key (Get from https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=your_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=certchain@pub.edu.bd
BREVO_SENDER_NAME=PUB CertChain Authority

# ------------------------------------------------------------------------------
# 5. Default Super Admin Seed Credentials (scripts/create-super-admin.mjs)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@pub.edu.bd
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Super Administrator
